<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/auth_graph.xml"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="code.name.monkey.retromusic.fragments.auth.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" />
    <fragment
        android:id="@+id/loginFragment"
        android:name="code.name.monkey.retromusic.fragments.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" />
    <fragment
        android:id="@+id/registerFragment"
        android:name="code.name.monkey.retromusic.fragments.auth.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" />
    <fragment
        android:id="@+id/homeLoginFragment"
        android:name="code.name.monkey.retromusic.fragments.auth.HomeLoginFragment"
        android:label="fragment_home_login"
        tools:layout="@layout/fragment_home_login" />
    <fragment
        android:id="@+id/homeRegisterFragment"
        android:name="code.name.monkey.retromusic.fragments.auth.HomeRegisterFragment"
        android:label="fragment_home_register"
        tools:layout="@layout/fragment_home_register" />
    <fragment
        android:id="@+id/otpFragment"
        android:name="code.name.monkey.retromusic.fragments.auth.OtpFragment"
        android:label="fragment_otp"
        tools:layout="@layout/fragment_otp" />

    <fragment
        android:id="@+id/setPassFragment"
        android:name="code.name.monkey.retromusic.fragments.auth.SetPassFragment"
        android:label="fragment_set_pass"
        tools:layout="@layout/fragment_set_pass" />
</navigation>